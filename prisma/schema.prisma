// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A person using the service desk. One table covers every role because
// ITIL roles are just permissions/behaviour on top of the same "person"
// concept — a Manager is still a person who can also submit their own
// incidents.
model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  Role   @default(CUSTOMER)

  // Never a plaintext password — only ever the bcrypt hash. See
  // src/lib/password.ts. Real accounts only: there is no "guest" concept,
  // every User row is someone who signed up or was provisioned.
  passwordHash String

  // True only for the handful of seeded personas (one per role) used by
  // the "quick demo sign-in" buttons on the login page. This is what
  // keeps that feature from ever listing a real customer's account —
  // self-registered users are never marked true, so quick sign-in can
  // only ever offer accounts nobody outside this repo's seed data owns.
  isDemoAccount Boolean @default(false)

  // Incidents this user raised (they are the "customer" on the ticket).
  reportedIncidents Incident[] @relation("Requester")
  // Incidents currently assigned to this user for work (they are the "agent").
  assignedIncidents Incident[] @relation("Assignee")
  // Every activity/comment this user authored, across all incidents.
  activities        IncidentActivity[]
  // Every attempt at a training scenario this user has made — see
  // TrainingAttempt for why "every attempt" rather than "current answer".
  trainingAttempts  TrainingAttempt[]
  // This user's simulated inbox — see Notification below.
  notifications     Notification[]
  // Every Shift (a queued batch of practice calls) this user has run.
  shifts            Shift[]

  // Problem Management (v2, internal/agent+manager only, see Problem below).
  ownedProblems     Problem[]         @relation("ProblemOwner")
  raisedProblems    Problem[]         @relation("ProblemRaisedBy")
  problemActivities ProblemActivity[]

  createdAt DateTime @default(now())
}

// ITIL support tiers. L1 = first line (triage, easy fixes), L2 = deeper
// technical skill, L3 = specialist/vendor-level. MANAGER can see and
// reassign everything but isn't a fix-it tier itself.
enum Role {
  CUSTOMER
  AGENT_L1
  AGENT_L2
  AGENT_L3
  MANAGER
}

// The ITIL Incident record: "an unplanned interruption to a service,
// or a reduction in quality of a service."
model Incident {
  id           String @id @default(cuid())
  // Human-facing ticket number, e.g. "INC000042" — what a person reads
  // and quotes on the phone, as opposed to the opaque `id` above which
  // only the database/URLs care about.
  ticketNumber String @unique

  title       String
  description String
  category    IncidentCategory

  // Impact and Urgency are captured independently because ITIL derives
  // Priority from the *combination* of the two (see src/types/itil.ts
  // for the matrix) — they are not the same axis.
  impact   Impact
  urgency  Urgency
  priority Priority

  status IncidentStatus @default(NEW)

  requester   User   @relation("Requester", fields: [requesterId], references: [id])
  requesterId String

  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id])
  assigneeId String?

  // Which support tier's queue this ticket currently belongs to. While
  // `assignee` is set, this always matches the assignee's role — but a
  // ticket sitting unassigned (freshly logged, or just escalated and
  // waiting for someone at the new tier to pick it up) has no assignee to
  // read a tier off of, so this field is what routes it into the right
  // tier's queue on each agent's dashboard.
  currentTier Role @default(AGENT_L1)

  // SLA (Service Level Agreement) targets, calculated from `priority`
  // at creation time using the policy in src/types/itil.ts. These are
  // stored (not just computed on the fly) so that a ticket's SLA clock
  // doesn't silently shift if the policy is edited later.
  //
  // Response and Resolution are two separate SLA promises in ITIL — "we
  // acknowledged this" is not the same commitment as "we fixed this" —
  // so each gets its own due date AND its own permanent breached
  // verdict, recorded the moment it's actually met (first response /
  // resolution), not left as a countdown that goes stale once the
  // ticket closes.
  slaResponseDueAt    DateTime
  respondedAt         DateTime?
  slaResponseBreached Boolean   @default(false)

  slaResolveDueAt    DateTime
  slaResolveBreached Boolean  @default(false)

  resolutionNotes String?
  resolvedAt      DateTime?
  closedAt        DateTime?

  // Root cause tracking (ITIL Problem Management, v2). Nullable, since
  // most incidents never get linked to a Problem; only when several
  // incidents trace back to the same underlying cause, or one triggers a
  // formal investigation, does this get set. See Problem below.
  problem   Problem? @relation(fields: [problemId], references: [id])
  problemId String?

  activities    IncidentActivity[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IncidentCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  ACCOUNT
  OTHER
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum Priority {
  P1_CRITICAL
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum IncidentStatus {
  NEW
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

// The audit trail for a single incident: every status change, assignment,
// escalation and comment, in order. This is what makes a ticket's history
// visible and is a core expectation of any real service desk tool.
model IncidentActivity {
  id         String   @id @default(cuid())
  incident   Incident @relation(fields: [incidentId], references: [id])
  incidentId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  type    ActivityType
  message String

  createdAt DateTime @default(now())
}

enum ActivityType {
  CREATED
  ASSIGNED
  ESCALATED
  STATUS_CHANGED
  COMMENT
  RESOLVED
  CLOSED
  PROBLEM_LINKED
}

// A simulated email notification — this app never sends a real email
// (no mail provider, nothing leaves the app), but every real service
// desk tool pings someone the moment their ticket moves: an agent gets
// assigned something, a customer's ticket gets resolved. Modeling that
// as an in-app "inbox" is what makes checking `/inbox` feel like an
// actual part of the job, not just a UI afterthought — see
// docs/BUILD_LOG.md for why this was built at all.
//
// Denormalizes `subject`/`body` as plain text (rather than, say,
// composing them from IncidentActivity + a template at read time)
// because a notification is a point-in-time message — "your ticket was
// resolved" shouldn't reword itself if the ticket's title changes later.
model Notification {
  id          String @id @default(cuid())
  recipient   User   @relation(fields: [recipientId], references: [id])
  recipientId String

  incident   Incident? @relation(fields: [incidentId], references: [id])
  incidentId String?

  subject String
  body    String
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}

// The ITIL Problem record: the underlying root cause behind one or more
// Incidents. Where an Incident is "the printer isn't working right now"
// (get the customer unblocked), a Problem is "why does the printer keep
// jamming" (stop it from happening again), a different question, worked
// by a different, internal-only process. Customers never see this model
// or any /problems page: see isAgentRole gating on every one of them.
//
// Deliberately no currentTier/escalation ladder like Incident has: Problem
// volume is far lower by design (many Incidents can trace back to one
// Problem), and there's no SLA clock driving urgent tiered triage here.
// A single nullable `owner`, self-assignable by any agent/manager, gives
// "who owns this" without duplicating Incident's whole L1->L2->L3 machinery
// for a signal this project doesn't otherwise teach about Problems.
model Problem {
  id            String @id @default(cuid())
  // Human-facing reference, e.g. "PRB000001": same cosmetic-numbering
  // approach (and the same count-based known limitation) as
  // Incident.ticketNumber; see the comment there.
  problemNumber String @unique

  title       String
  description String
  // Reuses IncidentCategory rather than a parallel taxonomy, since a
  // Problem's category is inherently the same axis as the Incidents
  // rooted in it.
  category    IncidentCategory

  // Reuses Incident's Impact/Urgency/Priority machinery (see
  // src/types/itil.ts) instead of inventing a parallel scale. Unlike
  // Incident, a Problem has no SLA fields: SLA is a promise made to
  // whoever raised a ticket, and Problem investigation has no such
  // per-record deadline in this project's scope.
  impact   Impact
  urgency  Urgency
  priority Priority

  status ProblemStatus @default(NEW)

  owner   User?   @relation("ProblemOwner", fields: [ownerId], references: [id])
  ownerId String?

  // Whoever raised the Problem, always an agent or manager.
  raisedBy   User   @relation("ProblemRaisedBy", fields: [raisedById], references: [id])
  raisedById String

  // Set together the moment a workaround is recorded, since this pair IS
  // what makes a Problem a "Known Error" in ITIL terms. There's
  // deliberately no separate boolean flag for that: KNOWN_ERROR is a
  // `status` value set atomically with these two fields by
  // recordWorkaround(), so the workaround text and the status can never
  // drift apart.
  workaround   String?
  workaroundAt DateTime?

  // Set together by resolveProblem(), required at resolve time, the same
  // pattern as Incident.resolutionNotes/resolvedAt, because "resolved but
  // no explanation of why" isn't a real resolution.
  rootCause  String?
  resolvedAt DateTime?
  closedAt   DateTime?

  // Every Incident that traces back to this Problem: many Incidents can
  // link to one Problem (five separate "VPN keeps dropping" tickets, one
  // underlying cause).
  incidents Incident[]

  activities ProblemActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProblemStatus {
  NEW
  INVESTIGATING
  KNOWN_ERROR
  RESOLVED
  CLOSED
}

// The audit trail for a single problem, same purpose and shape as
// IncidentActivity, kept as its own table for the same reason
// IncidentActivity isn't shared with anything else: a plain `problemId`
// foreign key is far simpler than a generic "activity on some entity"
// table.
model ProblemActivity {
  id        String  @id @default(cuid())
  problem   Problem @relation(fields: [problemId], references: [id])
  problemId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  type    ProblemActivityType
  message String

  createdAt DateTime @default(now())
}

enum ProblemActivityType {
  CREATED
  ASSIGNED
  WORKAROUND_RECORDED
  RESOLVED
  CLOSED
  INCIDENT_LINKED
  COMMENT
}

// The Training Simulator: a "call comes in" practice mode, separate from
// the real Incident table on purpose — a practice attempt at a canned
// scenario has nothing to do with real ticket data, and mixing them would
// mean every incident query in the app needs to start filtering out fake
// training tickets. This is intentionally its own small subsystem.
//
// A scenario is written as a caller would actually describe their
// problem on the phone — including some vagueness, because reading past
// that ambiguity to ask the right diagnostic question is the actual
// skill being taught, not just pattern-matching a keyword to a category.
model TrainingScenario {
  id         String             @id @default(cuid())
  title      String
  category   IncidentCategory
  difficulty TrainingDifficulty @default(BEGINNER)

  // What the caller says when the call starts.
  callerOpening String
  // What the caller says next, after the agent asks a first clarifying
  // question — a second beat of dialogue to sell "this is a phone call"
  // without building a full branching conversation engine.
  callerFollowUp String

  // The diagnostic question the trainee actually answers, e.g. "What's
  // your first troubleshooting step?" — deliberately about the PROCESS
  // (what would a real agent do first), not just "what's broken?".
  question String

  choices TrainingChoice[]

  // The real fix, shown after the trainee answers regardless of whether
  // they got it right — this is the actual teaching payoff, not just a
  // right/wrong verdict.
  resolutionSteps String

  attempts  TrainingAttempt[]
  createdAt DateTime          @default(now())
}

enum TrainingDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model TrainingChoice {
  id         String           @id @default(cuid())
  scenario   TrainingScenario @relation(fields: [scenarioId], references: [id])
  scenarioId String

  text      String
  isCorrect Boolean @default(false)
  // Shown after the trainee picks THIS option specifically, whether or
  // not it was correct — "why this is/isn't the right first move" is
  // more useful feedback than a bare correct/incorrect flag.
  explanation String
  // Display order — choices aren't meant to be alphabetized or reordered
  // by "correct answer last", they're written in a deliberate sequence.
  order Int @default(0)

  attempts TrainingAttempt[]
}

// One attempt at one scenario. Deliberately append-only (never updated or
// deleted) rather than "the user's current answer" — a trainee retrying a
// scenario after getting it wrong the first time is the whole point of a
// training tool, and an append-only log is what lets a "your accuracy
// over your last N attempts" stat exist later without a schema change.
model TrainingAttempt {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id])
  userId     String
  scenario   TrainingScenario @relation(fields: [scenarioId], references: [id])
  scenarioId String
  choice     TrainingChoice   @relation(fields: [choiceId], references: [id])
  choiceId   String
  // Denormalized from choice.isCorrect at the moment of the attempt, so a
  // later edit to a scenario's correct answer doesn't rewrite history.
  wasCorrect Boolean

  // Set only when this attempt happened as part of a Shift (see below),
  // null for ordinary freeform practice from /training. What actually
  // distinguishes a shift attempt isn't this link, though — it's that
  // shift mode never lets you retry a call once answered, the same way a
  // real shift doesn't let you rewind a call that already happened.
  shift   Shift?  @relation(fields: [shiftId], references: [id])
  shiftId String?

  createdAt DateTime @default(now())
}

// Shift Mode: several calls back-to-back, no retries mid-shift, ending in
// a summary — the closer-to-a-real-job version of the Training Simulator,
// versus freeform practice on one scenario at a time from /training.
//
// `scenarioIds` fixes the queue for the whole shift at creation time
// (a Postgres native array, not a join table — the order matters and
// never changes, so there's nothing a join table's extra structure would
// buy here). Which call is "current" is never stored directly; it's
// always derived as `scenarioIds[attempts.length]` — the same
// derive-it-from-what-actually-happened approach used throughout this
// app (e.g. an incident's SLA risk is computed at render time, not
// cached) rather than a position counter that could drift out of sync
// with the attempts actually recorded.
model Shift {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  scenarioIds String[]
  attempts    TrainingAttempt[]

  startedAt   DateTime  @default(now())
  // Set the moment the shift's last call gets an attempt — a null value
  // is exactly how the summary page below knows whether to render "in
  // progress" or "complete".
  completedAt DateTime?
}
