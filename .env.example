# Copy this file to .env and fill in your own connection string.
#
# This project uses PostgreSQL, hosted on Prisma Postgres in this repo's
# own deployment — but any PostgreSQL database works (Prisma Postgres,
# Supabase, Neon, Railway, a local Postgres install, etc.). See
# docs/DEPLOYMENT.md for how to provision a free Prisma Postgres database
# in a couple of minutes if you don't already have one.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
